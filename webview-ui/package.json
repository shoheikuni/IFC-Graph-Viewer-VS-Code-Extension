{
  "name": "ifc-node-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "cp node_modules/web-ifc/web-ifc.wasm . && vite",
    "build": "vue-tsc --noEmit && vite build && cp node_modules/web-ifc/web-ifc.wasm build/",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit",
    "licenses": "license-checker-rseidelsohn --production --markdown"
  },
  "dependencies": {
    "axios": "^1.9.0",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.5",
    "web-ifc": "^0.0.58"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/vscode-webview": "^1.57.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.5.1",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.0.2",
    "vite": "^6.3.3",
    "vue-tsc": "^2.2.0"
  }
}
